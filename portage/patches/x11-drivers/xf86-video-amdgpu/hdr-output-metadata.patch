+/*
+ * HDR_OUTPUT_METADATA: the KMS blob as a RandR byte array, either a whole
+ * struct hdr_output_metadata or a single 0 byte for none. This is what lets
+ * an X client (an HDR video player) switch the sink into HDR mode.
+ */
+static void drmmode_output_create_hdr_metadata(xf86OutputPtr output,
+					       uint32_t blob_id)
+{
+	drmmode_output_private_ptr drmmode_output = output->driver_private;
+	AMDGPUEntPtr pAMDGPUEnt = AMDGPUEntPriv(output->scrn);
+	drmModePropertyBlobPtr blob = NULL;
+	uint8_t zero = 0;
+	void *data = &zero;
+	unsigned long length = 1;
+	int err;
+
+	drmmode_output->hdr_metadata_atom =
+		MakeAtom("HDR_OUTPUT_METADATA", 19, TRUE);
+	if (drmmode_output->hdr_metadata_atom == BAD_RESOURCE) {
+		drmmode_output->hdr_metadata_prop_id = 0;
+		return;
+	}
+
+	if (blob_id)
+		blob = drmModeGetPropertyBlob(pAMDGPUEnt->fd, blob_id);
+	if (blob && blob->length == sizeof(struct hdr_output_metadata)) {
+		data = blob->data;
+		length = blob->length;
+	}
+
+	err = RRChangeOutputProperty(output->randr_output,
+				     drmmode_output->hdr_metadata_atom,
+				     XA_INTEGER, 8, PropModeReplace, length,
+				     data, FALSE, FALSE);
+	if (err != Success)
+		xf86DrvMsg(output->scrn->scrnIndex, X_ERROR,
+			   "Changing HDR_OUTPUT_METADATA property failed with %d\n",
+			   err);
+	drmModeFreePropertyBlob(blob);
+}
+
+static Bool drmmode_output_set_hdr_metadata(xf86OutputPtr output,
+					    RRPropertyValuePtr value)
+{
+	drmmode_output_private_ptr drmmode_output = output->driver_private;
+	AMDGPUEntPtr pAMDGPUEnt = AMDGPUEntPriv(output->scrn);
+	uint32_t blob_id = 0;
+	int ret;
+
+	if (value->type != XA_INTEGER || value->format != 8)
+		return FALSE;
+
+	if (value->size == sizeof(struct hdr_output_metadata)) {
+		ret = drmModeCreatePropertyBlob(pAMDGPUEnt->fd, value->data,
+						value->size, &blob_id);
+		if (ret) {
+			xf86DrvMsg(output->scrn->scrnIndex, X_ERROR,
+				   "Creating DRM blob failed with errno %d\n",
+				   ret);
+			return FALSE;
+		}
+	} else if (value->size != 1 || *(uint8_t *)value->data != 0) {
+		return FALSE;
+	}
+
+	/* Entering or leaving HDR (blob 0 <-> non-0) is a full modeset in
+	 * amdgpu; changing one blob for another is not.
+	 */
+	ret = drmModeConnectorSetProperty(pAMDGPUEnt->fd,
+					  drmmode_output->output_id,
+					  drmmode_output->hdr_metadata_prop_id,
+					  blob_id);
+
+	/* If successful, kernel will have a reference already. Safe to destroy
+	 * the blob either way.
+	 */
+	if (blob_id)
+		drmModeDestroyPropertyBlob(pAMDGPUEnt->fd, blob_id);
+
+	if (ret) {
+		xf86DrvMsg(output->scrn->scrnIndex, X_ERROR,
+			   "Setting HDR_OUTPUT_METADATA failed with errno %d\n",
+			   ret);
+		return FALSE;
+	}
+
+	return TRUE;
+}
